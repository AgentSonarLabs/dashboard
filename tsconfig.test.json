{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "incremental": false,
    "outDir": ".test-build",
    "rootDir": "src"
  },
  "include": [
    "src/shared/api/**/*.ts",
    "src/shared/lib/format/**/*.ts",
    "src/shared/lib/trace-timeline.ts"
  ],
  "exclude": ["node_modules", ".next", ".test-build"]
}
